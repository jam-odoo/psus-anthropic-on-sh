<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="rental_deposit_view_list" model="ir.ui.view">
        <field name="name">rental.deposit.list</field>
        <field name="model">rental.deposit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="rental_order_id"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="rental_deposit_view_form" model="ir.ui.view">
        <field name="name">rental.deposit.form</field>
        <field name="model">rental.deposit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="rental_order_id"/>
                        <field name="amount"/>
                        <field name="currency_id"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rental_deposit_action" model="ir.actions.act_window">
        <field name="name">Deposits</field>
        <field name="res_model">rental.deposit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_rental_deposit"
        name="Deposits"
        parent="sale_renting.rental_menu_root"
        action="rental_deposit_action"
        sequence="20"/>

</odoo>
